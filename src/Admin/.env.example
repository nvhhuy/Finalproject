# Dev proxy target for /api (vite.config.ts). Use http://localhost:5076 for HTTP-only API.
VITE_API_PROXY_TARGET=https://localhost:7124

# Optional: absolute API base (production). Leave empty to use same-origin /api proxy.
# VITE_API_BASE_URL=https://api.example.com

# Cloudflare Turnstile site key (public, from Cloudflare dashboard → Turnstile → Site key).
# Leave empty to disable the widget (backend Turnstile.Enabled=false by default).
# VITE_TURNSTILE_SITE_KEY=your-site-key
