    <ItemGroup>
        <ProjectReference Include="..\Application\Application.csproj"/>
        <ProjectReference Include="..\Domains\Domains.csproj"/>
        <ProjectReference Include="..\Shared\Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Infrastructure.Tests"/>
        <InternalsVisibleTo Include="Worker.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Email\Templates\**\*.html" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
