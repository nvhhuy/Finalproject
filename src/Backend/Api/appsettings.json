{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "RabbitMQ.Client": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Realtime": {
    "Enabled": false,
    "UseRedisBackplane": true
  },
  "Email": {
    "QueueViaOutbox": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 2
  },
  "Hsts": {
    "MaxAgeDays": 730,
    "IncludeSubDomains": true,
    "Preload": true
  },
  "Database": {
    "ApplyPendingMigrations": false
  },
  "Seed": {
    "Admin": {
      "Enabled": false,
      "Email": "admin@localhost.com",
      "UserName": "admin",
      "Password": "",
      "FirstName": "Admin",
      "LastName": "User"
    }
  },
  "ConnectionStrings": {
    "DatabaseConnectionString": "",
    "DatabaseReadConnectionString": ""
  },
  "JwtSettings": {
    "Secret": "",
    "ExpirationTimeInMinutes": 60,
    "RefreshTokenExpirationDays": 14,
    "Issuer": "",
    "Audience": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "ObjectStorage": {
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "auto",
    "Bucket": "media",
    "ForcePathStyle": true,
    "CdnBaseUrl": "",
    "PresignedUrlExpirationMinutes": 10,
    "UsePresignedDownloads": false,
    "PresignedDownloadUrlExpirationMinutes": 15
  },
  "DatabaseBackup": {
    "PgDumpPath": "pg_dump",
    "PgRestorePath": "pg_restore",
    "MaxSettingsImportBytes": 10485760,
    "MaxDatabaseImportBytes": 536870912
  },
  "Cors": {
    "AllowedOrigins": [],
    "ExposedHeaders": [
      "X-Correlation-Id"
    ],
    "AllowCredentials": true
  },
  "DataProtection": {
    "ApplicationName": "baseproject",
    "KeysDirectory": "",
    "AllowEphemeralKeys": false
  },
  "MediaScanner": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 3310,
    "ConnectTimeoutSeconds": 5,
    "ScanTimeoutSeconds": 60,
    "FailClosed": false
  },
  "VideoProcessing": {
    "FfmpegPath": "",
    "FfprobePath": "",
    "MaxTranscodeHeightPx": 720,
    "VideoCodec": "libx264",
    "AudioCodec": "aac",
    "AudioBitrate": "128k",
    "Preset": "veryfast",
    "Crf": 23,
    "HwAccel": ""
  },
  "Media": {
    "Upload": {
      "PresignedUrlExpirationMinutes": 10,
      "MaxUploadBytes": 2147483648,
      "MaxConcurrentVideoRungs": 1,
      "AdditionalVideoCodecs": [],
      "EnableHls": false,
      "HlsSegmentDurationSeconds": 6
    }
  },
  "PasswordReset": {
    "PublicAppBaseUrl": "",
    "TokenTtlMinutes": 30
  },
  "Smtp": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 587,
    "UseSsl": true,
    "FromAddress": "noreply@localhost",
    "FromDisplayName": "Base Project"
  },
  "Idempotency": {
    "RetentionHours": 24,
    "InProgressTimeoutMinutes": 5
  },
  "TenantRateLimit": {
    "AnonymousRequestsPerMinute": 60,
    "DefaultRequestsPerMinute": 120,
    "PlatformAdminRequestsPerMinute": 2000
  },
  "Tenancy": {
    "SubdomainBaseHost": "",
    "ReservedSubdomains": [
      "www",
      "api",
      "admin",
      "app",
      "mail",
      "static"
    ],
    "VerificationTxtPrefix": "_baseproject-verify",
    "PlatformCnameTarget": ""
  },
  "FeatureFlags": {
    "Flags": {
      "auth.allow_public_register": {
        "Default": true,
        "DbKey": "feature.auth.allow_public_register"
      }
    }
  },
  "Messaging": {
    "Stripe": {
      "WebhookSecret": ""
    },
    "RabbitMq": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "DefaultExchange": "baseproject.events"
    }
  }
}