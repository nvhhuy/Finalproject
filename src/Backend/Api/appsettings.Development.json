{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenSearch"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "OpenSearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "logs-{0:yyyy.MM.dd}"
        }
      }
    ]
  },
  "Database": {
    "ApplyPendingMigrations": true
  },
  "Seed": {
    "Admin": {
      "Enabled": true,
      "Email": "admin@localhost.com",
      "UserName": "admin",
      "Password": "Temp!ChangeMe123",
      "FirstName": "Admin",
      "LastName": "User"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DatabaseConnectionString": "Host=localhost;Port=5432;Database=baseproject;Username=postgres;Password=postgres",
    "DatabaseReadConnectionString": "Host=localhost;Port=5432;Database=baseproject;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "DevelopmentSigningKey_ChangeMe_UseLongSecretAtLeast32Chars!",
    "ExpirationTimeInMinutes": 60,
    "RefreshTokenExpirationDays": 14,
    "Issuer": "BaseProject.Api",
    "Audience": "BaseProject.Client"
  },
  "Realtime": {
    "Enabled": true,
    "UseRedisBackplane": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Email": {
    "QueueViaOutbox": true
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"
    }
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "minio",
    "SecretKey": "minio123",
    "Region": "us-east-1",
    "Bucket": "media",
    "ForcePathStyle": true,
    "UsePresignedDownloads": true,
    "PresignedDownloadUrlExpirationMinutes": 60
  },
  "VideoProcessing": {
    "FfmpegPath": "",
    "FfprobePath": ""
  },
  "PasswordReset": {
    "PublicAppBaseUrl": "http://localhost:3000",
    "TokenTtlMinutes": 30
  },
  "EmailBranding": {
    "AppName": "Klassi"
  },
  "WebPush": {
    "Enabled": true,
    "VapidPublicKey": "BEKC74bUQAqKKa5NVpaHHHNUQK2UCZ_-OGDdYDws7Sw8Vw5YwOp5J5AAFFfslYOcWGY7s314VLyecBenxKlUqzE",
    "VapidPrivateKey": "dBCyRy1w4eBisPlLE0M2gz3uZQwQgZXAgRp6i81wd6o",
    "Subject": "mailto:noreply@localhost"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "noreply@localhost",
    "FromDisplayName": "Klassi Dev"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:3000"
    ]
  },
  "DataProtection": {
    "ApplicationName": "baseproject",
    "KeysDirectory": "../../../local/dataprotection-keys"
  },
  "Messaging": {
    "RabbitMq": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "DefaultExchange": "baseproject.events"
    }
  }
}