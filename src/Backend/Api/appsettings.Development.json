{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenSearch" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenSearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "logs-{0:yyyy.MM.dd}"
        }
      }
    ]
  },
  "Database": {
    "ApplyPendingMigrations": true
  },
  "Seed": {
    "Admin": {
      "Enabled": true,
      "Email": "admin@localhost",
      "UserName": "admin",
      "Password": "Temp!ChangeMe123",
      "FirstName": "Admin",
      "LastName": "User"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DatabaseConnectionString": "Host=localhost;Port=5432;Database=finalproject;Username=postgres;Password=postgres",
    "DatabaseReadConnectionString": "Host=localhost;Port=5432;Database=finalproject;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "DevelopmentSigningKey_ChangeMe_UseLongSecretAtLeast32Chars!",
    "ExpirationTimeInMinutes": 60,
    "RefreshTokenExpirationDays": 14,
    "Issuer": "FinalProject.Api",
    "Audience": "FinalProject.Client"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"
    }
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "minio",
    "SecretKey": "minio123",
    "Region": "auto",
    "ForcePathStyle": true,
    "PublicBaseUrl": ""
  },
  "VideoProcessing": {
    "FfmpegPath": "",
    "FfprobePath": ""
  },
  "PasswordReset": {
    "PublicAppBaseUrl": "http://localhost:5173",
    "TokenTtlMinutes": 30
  },
  "Smtp": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "noreply@localhost",
    "FromDisplayName": "Final Project Dev"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:3000"
    ]
  },
  "Messaging": {
    "RabbitMq": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "DefaultExchange": "finalproject.events"
    }
  }
}
