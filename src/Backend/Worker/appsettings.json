{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Worker": {
    "SampleCronExpression": "*/10 * * * *",
    "EnableSampleBackgroundLoop": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DatabaseConnectionString": "",
    "DatabaseReadConnectionString": ""
  },
  "JwtSettings": {
    "Secret": "",
    "ExpirationTimeInMinutes": 60,
    "RefreshTokenExpirationDays": 14,
    "Issuer": "",
    "Audience": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "ObjectStorage": {
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "auto",
    "ForcePathStyle": true,
    "PublicBaseUrl": ""
  },
  "VideoProcessing": {
    "FfmpegPath": "",
    "FfprobePath": ""
  }
}
