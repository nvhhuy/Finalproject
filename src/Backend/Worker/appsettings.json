{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "RabbitMQ.Client": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Worker": {
    "SampleCronExpression": "*/10 * * * *",
    "EnableSampleBackgroundLoop": false,
    "UseQuartzScheduler": true
  },
  "Worker:Quartz": {
    "UsePersistentStore": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "JwtSettings": {
    "Secret": "",
    "ExpirationTimeInMinutes": 60,
    "RefreshTokenExpirationDays": 14,
    "Issuer": "BaseProject.Api",
    "Audience": "BaseProject.Client"
  },
  "ConnectionStrings": {
    "DatabaseConnectionString": "",
    "DatabaseReadConnectionString": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "ObjectStorage": {
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "auto",
    "Bucket": "media",
    "ForcePathStyle": true,
    "CdnBaseUrl": "",
    "PresignedUrlExpirationMinutes": 10,
    "UsePresignedDownloads": false,
    "PresignedDownloadUrlExpirationMinutes": 15
  },
  "DataProtection": {
    "ApplicationName": "baseproject",
    "KeysDirectory": "",
    "AllowEphemeralKeys": false
  },
  "MediaScanner": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 3310,
    "ConnectTimeoutSeconds": 5,
    "ScanTimeoutSeconds": 60,
    "FailClosed": false
  },
  "VideoProcessing": {
    "FfmpegPath": "",
    "FfprobePath": "",
    "MaxTranscodeHeightPx": 720,
    "VideoCodec": "libx264",
    "AudioCodec": "aac",
    "AudioBitrate": "128k",
    "Preset": "veryfast",
    "Crf": 23,
    "HwAccel": ""
  },
  "Media": {
    "Upload": {
      "PresignedUrlExpirationMinutes": 10,
      "MaxUploadBytes": 2147483648,
      "MaxConcurrentVideoRungs": 1,
      "AdditionalVideoCodecs": [],
      "EnableHls": false,
      "HlsSegmentDurationSeconds": 6
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "DefaultExchange": "baseproject.events"
    }
  }
}
