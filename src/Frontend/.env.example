# Dev proxy target for /api and /hubs (app/api/[...path]/route.ts, app/hubs/[...path]/route.ts). Same as Admin.
API_PROXY_TARGET=https://localhost:7124

# Google Sign-In (Web client ID from Google Cloud Console)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: absolute API base (production). Leave empty to use same-origin /api proxy.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Tenant subdomain routing ({slug}.app.example.com). Match Tenancy:SubdomainBaseHost on API.
# TENANT_SUBDOMAIN_BASE_HOST=localhost

# Cloudflare Turnstile site key (public, shown in the Cloudflare dashboard → Turnstile → Site key).
# Leave empty to disable the widget in development. The backend also has Turnstile.Enabled=false by default.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
