# Staging app secrets — copy to app.env and fill values.
# Use with: deploy/scripts/up.sh staging

# For self-hosted infra (deploy/compose/infra.yml):
#   ./deploy/scripts/infra-up.sh staging
# This file should match credentials from deploy/env/staging/infra.env.

DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=baseproject;Username=postgres;Password=change_me_staging
DATABASE_READ_CONNECTION_STRING=Host=postgres;Port=5432;Database=baseproject;Username=postgres;Password=change_me_staging
REDIS_CONNECTION_STRING=redis:6379,password=change_me_staging,abortConnect=false

JWT_SECRET=change_me_minimum_32_characters_long_secret
JWT_ISSUER=BaseProject.Api
JWT_AUDIENCE=BaseProject.Client

SEED_ADMIN_ENABLED=false
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change_me_staging
EMAIL_QUEUE_VIA_OUTBOX=true

REALTIME_ENABLED=true
REALTIME_USE_REDIS_BACKPLANE=true
WORKER_QUARTZ_USE_PERSISTENT_STORE=true

OBJECT_STORAGE_SERVICE_URL=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=change_me_staging
OBJECT_STORAGE_BUCKET=media
OBJECT_STORAGE_USE_PRESIGNED=true
