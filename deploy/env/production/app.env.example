# Production app secrets — copy to app.env (store real file in vault / host only).
# If using self-hosted infra, values should align with deploy/env/production/infra.env.

DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=baseproject;Username=app;Password=change_me_prod
DATABASE_READ_CONNECTION_STRING=Host=postgres;Port=5432;Database=baseproject;Username=app;Password=change_me_prod
REDIS_CONNECTION_STRING=redis:6379,password=change_me_prod,abortConnect=false

JWT_SECRET=change_me_minimum_32_characters_long_secret
JWT_ISSUER=BaseProject.Api
JWT_AUDIENCE=BaseProject.Client

SEED_ADMIN_ENABLED=false
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change_me_prod
EMAIL_QUEUE_VIA_OUTBOX=true

REALTIME_ENABLED=true
REALTIME_USE_REDIS_BACKPLANE=true
WORKER_QUARTZ_USE_PERSISTENT_STORE=true

OBJECT_STORAGE_SERVICE_URL=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=change_me_prod
OBJECT_STORAGE_BUCKET=media-prod
OBJECT_STORAGE_USE_PRESIGNED=true

# Payment webhook signing secrets — REQUIRED in production.
# Stripe: obtain from Stripe Dashboard > Webhooks > Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=whsec_change_me_prod
# VNPay: shared hash secret from VNPay merchant portal
VNPAY_WEBHOOK_SECRET=change_me_vnpay_hash_secret
# PayOS: checksum key from PayOS developer portal
PAYOS_WEBHOOK_SECRET=change_me_payos_checksum_key

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_DISPLAY_NAME=BaseProject
SMTP_USERNAME=
SMTP_PASSWORD=
