# Shared compose variables (copy to app.common.env per host).
COMPOSE_PROJECT_NAME=finalproject

# Harbor / local registry prefix (no trailing slash)
IMAGE_REGISTRY=harbor.example.com/finalproject
IMAGE_TAG=latest

# Public hostnames (DNS must point to Traefik before ACME succeeds)
APP_HOST=app.example.com
ADMIN_HOST=admin.example.com
GRAFANA_HOST=grafana.example.com
UPTIME_KUMA_HOST=uptime.example.com
OPENSEARCH_DASHBOARDS_HOST=logs.example.com
ALLOWED_HOSTS=app.example.com;admin.example.com

# Traefik basic auth for Grafana / OpenSearch Dashboards / Uptime Kuma (required when monitoring/observability profiles are enabled).
# Generate: htpasswd -nb admin 'your-password'  (escape $ as $$ in .env files)
OBSERVABILITY_BASIC_AUTH=admin:$$apr1$$example$$replace_me

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production

# Trust Docker bridge networks for X-Forwarded-* from Traefik
REVERSE_PROXY_KNOWN_NETWORK=172.16.0.0/12
