# Copy to `local/.env` and adjust if needed. Do not commit real secrets.

# Postgres (same DB for read+write in dev; use two hosts in prod)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finalproject

# OpenSearch (optional if 9200/5601 are in use)
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# MinIO (S3-compatible)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# Optional: paste into src/Backend/Api appsettings.Development.json or User Secrets
# DatabaseConnectionString=Host=localhost;Port=5432;Database=finalproject;Username=postgres;Password=postgres
# DatabaseReadConnectionString=Host=localhost;Port=5432;Database=finalproject;Username=postgres;Password=postgres
# Redis__ConnectionString=localhost:6379
# ObjectStorage__ServiceUrl=http://localhost:9000
# ObjectStorage__AccessKey=minio
# ObjectStorage__SecretKey=minio123
